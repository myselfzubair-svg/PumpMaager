# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# TWILIO_ACCOUNT_SID: Your Twilio Account SID for sending cloud OTP SMS.
TWILIO_ACCOUNT_SID=TWILIO_ACCOUNT_SID_PLACEHOLDER

# TWILIO_AUTH_TOKEN: Your Twilio Auth Token for sending cloud OTP SMS.
TWILIO_AUTH_TOKEN=TWILIO_AUTH_TOKEN_PLACEHOLDER

# TWILIO_SENDER_NUMBER: Your Twilio Phone Number or Alphanumeric Sender ID.
TWILIO_SENDER_NUMBER=TWILIO_SENDER_NUMBER_PLACEHOLDER

# FAST2SMS_API_KEY: Fast2SMS API key (popular in India for instant free/cheap OTP SMS).
FAST2SMS_API_KEY=FAST2SMS_API_KEY_PLACEHOLDER

# RECAPTCHA_SITE_KEY: reCAPTCHA Enterprise Site Key for App Check verification.
RECAPTCHA_SITE_KEY=RECAPTCHA_SITE_KEY_PLACEHOLDER

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Add any other environment-specific variables below
